render.text = false

local clicks = 0
local lastClicks = -1

local digits = require("digitTextures.mod")
local digitTextures = digits.digitTextures
local DIGIT_SIZE = digits.DIGIT_SIZE

local chars = require("characterTextures.lua")
local characterTextures = chars.characterTextures
local CHAR_SIZE = chars.CHAR_SIZE

local SCALE = 3
local SPACING = 20

local activeSprites = {}

local function clearSprites()
    for _, spr in ipairs(activeSprites) do
        spr:Destroy()
    end
    activeSprites = {}
end

local function drawText(str, startX, startY)
    clearSprites()

    local x = startX

    for i = 1, #str do
        local ch = str:sub(i, i)
        local tex

        if digitTextures[ch] then
            tex = digitTextures[ch]
        elseif characterTextures[ch] then
            tex = characterTextures[ch]
        end

        if tex then
            local spriteObj = sprite.new(tex, vector2.new(CHAR_SIZE, CHAR_SIZE))
            spriteObj.scale = vector2.new(SCALE, SCALE)
            spriteObj.position = vector2.new(x, startY)

            table.insert(activeSprites, spriteObj)

            x = x + SPACING
        end
    end
end

control:Connect(1, function(inputType, pressed)
    if inputType == "ButtonA" and pressed then
        clicks += 1
    end
end)

while true do
    if clicks ~= lastClicks then
        drawText(tostring(clicks), 20, 20)
        lastClicks = clicks
    end

    wait(0.01)
end