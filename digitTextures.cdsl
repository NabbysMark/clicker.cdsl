local C = 0x70
local DIGIT_SIZE = 6

local function makeTexture(grid)
    return texture.new(vector2.new(DIGIT_SIZE, DIGIT_SIZE), grid)
end

local digitTextures = {}

digitTextures[0] = makeTexture({
    C,C,C,C,C,C,
    C,0,0,0,0,C,
    C,0,0,0,0,C,
    C,0,0,0,0,C,
    C,0,0,0,0,C,
    C,C,C,C,C,C,
})

digitTextures[1] = makeTexture({
    0,0,C,0,0,0,
    0,C,C,0,0,0,
    0,0,C,0,0,0,
    0,0,C,0,0,0,
    0,0,C,0,0,0,
    0,0,C,0,0,0,
})

